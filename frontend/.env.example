# Copy to `.env.local`. Vite exposes only variables that start with VITE_.

# true: the in-memory mock server (no backend needed). false: the real Django backend.
VITE_USE_MOCKS=true

# Base URL of the API. Keep /api/v1 to use the Vite proxy in development (same-origin cookies).
VITE_API_BASE_URL=/api/v1

# Where the Vite dev server forwards /api when VITE_USE_MOCKS=false.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
