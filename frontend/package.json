    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@hookform/resolvers": "^3.10.0",
    "@mui/icons-material": "^6.5.0",
    "@mui/material": "^6.5.0",
    "@mui/utils": "^6.4.9",
    "@tanstack/react-query": "^5.105.0",
    "axios": "^1.20.0",
    "i18next": "^26.5.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.91.0",
    "react-i18next": "^17.1.9",
    "react-router-dom": "^6.30.6",
    "stylis": "^4.4.0",
