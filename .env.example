# Copy this file to `.env` in the same folder and fill in the values. `.env` is never committed.

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DB_NAME=citizen_service_center
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Front end (CORS and CSRF trusted origins, comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Sessions and login lockout (FR-AUTH-07)
SESSION_AGE_HOURS=8
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# ID card images (FR-VER-01)
ID_IMAGE_MAX_MB=5

# First System Administrator, created by `python manage.py seed_data`
SEED_ADMIN_EMAIL=admin@csc.local
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FULL_NAME=System Administrator
SEED_ADMIN_PHONE=0900000000
